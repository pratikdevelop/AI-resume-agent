# .env.example
# Copy this file to .env and fill in your real values
# Never commit .env to git!

# ── Gmail SMTP ────────────────────────────────────────────
# Your Gmail address that sends emails
GMAIL_SENDER=yourname@gmail.com

# 16-character App Password from myaccount.google.com/apppasswords
# Remove spaces when pasting: "abcd efgh ijkl mnop" → "abcdefghijklmnop"
GMAIL_APP_PASSWORD=abcdefghijklmnop

# ── Google Calendar ───────────────────────────────────────
# Calendar ID from Google Calendar settings
# For your main calendar this is usually just your Gmail address
GOOGLE_CALENDAR_ID=yourname@gmail.com

# Path to the service account JSON credentials file
GOOGLE_CREDENTIALS_FILE=credentials.json

# Your timezone (used for calendar events)
# See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=Asia/Kolkata
